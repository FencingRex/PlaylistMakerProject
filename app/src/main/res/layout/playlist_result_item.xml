<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="@dimen/iconPadding"
    >


    <ImageView
        android:id="@+id/playlistCover"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:background="@drawable/rounded_cover"
        android:scaleType="fitCenter"
        tools:src="@drawable/ic_cover_placeholder_104"
        app:layout_constraintDimensionRatio="1:1"
        android:clipToOutline="true"/>

    <TextView
        android:id="@+id/playlistName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Playlist Name"
        android:textColor="?attr/colorSurface"
        android:textSize="@dimen/textSizePlaylist"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/playlistTracksQty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorSurface"
        android:textSize="@dimen/textSizePlaylist"
        tools:text="Tracks qty in playlist"/>
</LinearLayout>